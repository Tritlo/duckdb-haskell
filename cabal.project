packages: duckdb-*/*.cabal

-- GHC version
with-compiler: ghc-9.14.1
-- Build tests, benchmarks, and documentation by default
tests:      True
benchmarks: True
documentation: True

-- Global compiler options
-- uuid-types has an overly tight upper bound on template-haskell,
-- which prevents building with GHC 9.14+ (template-haskell-2.24).
-- The optional DataFrame test uses bytestring-lexing. Its base bound excludes
-- GHC 9.14, but the package builds with base-4.22 without source changes.
allow-newer: uuid-types:template-haskell, bytestring-lexing:base

program-options

  -- Default warning flags
  ghc-options:
    -Wall
    -Werror
