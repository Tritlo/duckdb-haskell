+{- Note [Instance permalinks]
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+The class name does not identify an instance. An instance permalink must use
+its details element. Scope each method anchor by the instance identifier so
+instances of the same class do not define duplicate method anchors.
+-}
+
 subInstHead
   :: String
   -- ^ Instance unique id (for anchor generation)
@@ -256,9 +264,18 @@
   -- ^ Header content (instance name and type)
   -> Html
 subInstHead iid hdr =
-  expander noHtml <+> hdr
+  expander noHtml <+> hdr <+> (linkedAnchor (instAnchorId iid) ! [theclass "selflink"] << "#")
   where
     expander = thespan ! collapseControl (instAnchorId iid) "instance"
+
+-- | Render an instance method with an anchor scoped by its instance.
+-- See Note [Instance permalinks].
+subInstMethod :: LinksInfo -> SrcSpan -> Bool -> String -> DocName -> Html -> Html
+subInstMethod lnks loc splice iid name html =
+  (declElem ! [identifier methodAnchor])
+    << (html <+> links False lnks loc splice Nothing name <+> (linkedAnchor methodAnchor ! [theclass "selflink"] << "#"))
+  where
+    methodAnchor = instAnchorId iid ++ ":" ++ nameAnchorId (nameOccName (getName name))
 
