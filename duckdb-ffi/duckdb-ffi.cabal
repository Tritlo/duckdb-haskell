cabal-version: 3.4
name: duckdb-ffi
version: 1.5.6.0
author: Matthias Pall Gissurarson
maintainer: mpg@mpg.is
category: Database
build-type: Custom
tested-with:
  ghc ==9.10.3
  ghc ==9.12.4
  ghc ==9.14.1
  ghc ==9.6.7
  ghc ==9.8.4

license: MPL-2.0
license-file: LICENSE
synopsis: Low-level bindings to the DuckDB C API
homepage: https://github.com/Tritlo/duckdb-haskell
bug-reports: https://github.com/Tritlo/duckdb-haskell/issues
description:
  Haskell FFI bindings generated from the DuckDB C API with hs-bindgen.
  Supports native DuckDB >= 1.5.3 and < 1.6. Tested with versions 1.5.3 through 1.5.6.
  .
  Downloads a verified native library to the user cache on Linux and macOS.
  Uses an existing library when the user or Nix supplies it.

extra-doc-files: CHANGELOG.md
extra-source-files:
  cbits/duckdb.h
  cbits/duckdb_arrow.h
  generated.sha256
  scripts/binding-metadata.py
  scripts/generate-bindings.sh
  scripts/GenerateBindings.hs

source-repository head
  type: git
  location: https://github.com/Tritlo/duckdb-haskell.git
  subdir: duckdb-ffi

-- Setup.hs reads this flag. cabal check reports it as unused.
flag systemlib
  description: Use an installed DuckDB library without downloading it.
  default: False
  manual: True

custom-setup
  setup-depends:
    base >=4.18 && <4.23,
    Cabal >=3.10 && <3.19,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    process >=1.6 && <1.7,
    temporary >=1.3 && <1.4,

library
  default-language: GHC2021
  hs-source-dirs:
    src

  exposed-modules:
    Database.DuckDB.FFI

  include-dirs: cbits/
  install-includes:
    duckdb.h
    duckdb_arrow.h

  c-sources: cbits/abi-checks.c
  extra-libraries: duckdb
  build-depends:
    base >=4.18 && <4.23,
    hs-bindgen-runtime >=1.0.0.0 && <1.1,

test-suite duckdb-ffi-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    AggregateFunctionsTest
    AppenderTest
    ArrowInterfaceDeprecatedTests
    ArrowInterfaceTest
    BindValuesTest
    CastFunctionsTest
    ConfigurationTest
    DataChunkTest
    ErrorDataTest
    ExecutePreparedStatementsTest
    ExpressionTest
    ExtractStatementsTest
    HelpersTest
    LogicalTypesTest
    OpenConnectTest
    PendingResultTest
    PreparedStatementsTest
    ProfilingInfoTest
    QueryExecutionTest
    ReplacementScansTest
    ResultFunctionsTest
    SafeFetchTest
    ScalarFunctionsTest
    SelectionVectorTest
    StreamingResultTest
    TableDescriptionTest
    TableFunctionsTest
    ThreadingTest
    Utils
    ValidityMaskTest
    ValueInterfaceTest
    VectorTest

  ghc-options: -threaded
  default-language: Haskell2010
  build-depends:
    base >=4.18 && <4.23,
    duckdb-ffi,
    hs-bindgen-runtime >=1.0.0.0 && <1.1,
    tasty >=1.5 && <1.6,
    tasty-expected-failure >=0.12 && <0.13,
    tasty-hunit >=0.10 && <0.11,
    text >=2.0 && <2.2,
    time >=1.12 && <1.16,
