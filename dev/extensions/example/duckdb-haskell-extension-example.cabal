cabal-version: 3.4
name: duckdb-haskell-extension-example
version: 0.1.0.0
build-type: Simple
license: MPL-2.0
author: Matthias Pall Gissurarson
maintainer: mpg@mpg.is
synopsis: Loadable Haskell extension example for the pinned DuckDB V2 API
category: Database
description:
  A maintainer example with native V2 loading, managed Haskell callbacks,
  and process-lifetime GHC runtime initialization.

foreign-library haskell_demo
  type: native-shared
  hs-source-dirs: src
  other-modules:
    Advanced
    Demo

  c-sources: cbits/entry.c
  default-language: Haskell2010
  ghc-options: -threaded
  build-depends:
    base >=4.18 && <4.23,
    duckdb-ffi >=2.0.0.0 && <2.0.1,
    duckdb-simple >=0.4.0.0 && <0.5,
    text >=2.0 && <2.2,

test-suite haskell-demo-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  default-language: Haskell2010
  ghc-options: -threaded
  build-depends:
    base >=4.18 && <4.23,
    bytestring >=0.11 && <0.13,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    process >=1.6 && <1.7,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.12,
    unix >=2.8 && <2.9,
