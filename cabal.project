packages: duckdb-*/*.cabal

-- GHC version
with-compiler: ghc-9.14.1
-- Build tests, benchmarks, and documentation by default
tests:      True
benchmarks: True
documentation: True

-- Global compiler options
-- uuid-types has an overly tight upper bound on template-haskell,
-- which prevents building with GHC 9.14+ (template-haskell-2.24).
-- The optional DataFrame test uses bytestring-lexing. Its base bound excludes
-- GHC 9.14, but the package builds with base-4.22 without source changes.
allow-newer: debruijn:base, skew-list:base, uuid-types:template-haskell, bytestring-lexing:base

program-options

  -- Default warning flags
  ghc-options:
    -Wall
    -Werror

-- These private names occur in generated signatures and instance declarations.
-- They have no public documentation link. Keep warnings for all other names.
package duckdb-simple
  haddock-options:
    "--ignore-link-symbol=Database.DuckDB.Simple.Generic.GFromField'"
    "--ignore-link-symbol=Database.DuckDB.Simple.Generic.gFromField"
    "--ignore-link-symbol=Database.DuckDB.Simple.Generic.GToField'"
    "--ignore-link-symbol=Database.DuckDB.Simple.Generic.gToField"
    "--ignore-link-symbol=Database.DuckDB.Simple.Generic.gLogicalType"
    "--ignore-link-symbol=Database.DuckDB.Simple.Generic.IsSum"
    "--ignore-link-symbol=Database.DuckDB.Simple.Generic.Encoded"
    "--ignore-link-symbol=Database.DuckDB.Simple.Function.argumentType"
    "--ignore-link-symbol=Database.DuckDB.Simple.Function.scalarReturnType"
    "--ignore-link-symbol=Database.DuckDB.Simple.Function.toScalarValue"
    "--ignore-link-symbol=Database.DuckDB.Simple.TypeCache.TypeCache"
    "--ignore-link-symbol=Database.DuckDB.Simple.FromRow.RowParseRO"

package hs-bindgen
  optimization: False
